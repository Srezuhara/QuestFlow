# --- Postgres ---
POSTGRES_USER=questflow
POSTGRES_PASSWORD=questflow_dev_password
POSTGRES_DB=questflow
POSTGRES_PORT=5432

# --- Backend (FastAPI) ---
# Used by SQLAlchemy/Alembic inside the api/worker containers (host = service name "postgres")
DATABASE_URL=postgresql+asyncpg://questflow:questflow_dev_password@postgres:5432/questflow
# Dedicated database pytest runs against — never the same as DATABASE_URL, or the
# suite would wipe dev data (conftest.py asserts this at collection time).
TEST_DATABASE_URL=postgresql+asyncpg://questflow:questflow_dev_password@postgres:5432/questflow_test

# JWT
JWT_SECRET_KEY=change-me-dev-secret-access-do-not-use-in-prod
JWT_REFRESH_SECRET_KEY=change-me-dev-secret-refresh-do-not-use-in-prod
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30
JWT_ALGORITHM=HS256

# Web Push (VAPID) — generate real keys before phase 7 (see PHASE_7_8_9_PLAN.md §B.2)
VAPID_PUBLIC_KEY=placeholder-vapid-public-key
VAPID_PRIVATE_KEY=placeholder-vapid-private-key
VAPID_SUBJECT=mailto:admin@questflow.local

# CORS
CORS_ORIGIN=http://localhost:5173

# Environment
ENVIRONMENT=development

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
# Must equal VAPID_PUBLIC_KEY above — Vite bakes VITE_* at dev-server start.
VITE_VAPID_PUBLIC_KEY=placeholder-vapid-public-key
